# ETCswap Test Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets

# Mordor testnet wallet private key (without 0x prefix)
# Get testnet METC from: https://faucet.mordortest.net
MORDOR_PRIVATE_KEY=your_private_key_here

# Ethereum Classic mainnet wallet private key (without 0x prefix)
# WARNING: Use a dedicated test wallet with minimal funds
CLASSIC_PRIVATE_KEY=your_private_key_here

# Optional: Wallet addresses for read-only tests
MORDOR_WALLET_ADDRESS=your_wallet_address_here
CLASSIC_WALLET_ADDRESS=your_wallet_address_here
